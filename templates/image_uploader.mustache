{{!
    @template qtype_speakup/image_uploader

    Upload widget for image responses, e.g. scans of handwriting: up to
    "maxfiles" images or PDFs, shown in order as pages. The pages are listed
    by amd/src/imageupload.js.

    Context variables required for this template:
    * accept - the file types the file chooser offers.
    * multiple - whether more than one file can be chosen at once.

    Example context (json):
    {
        "accept": "image/*,application/pdf,.jpg,.png,.pdf",
        "multiple": true
    }
}}
<div class="qtype_speakup-image-widget my-1">
    <div class="qtype_speakup-no-recording-placeholder text-center w-100 mb-1">
        {{#str}}nofileuploaded, qtype_speakup{{/str}}
    </div>
    <ol class="qtype_speakup-image-list list-unstyled d-flex flex-wrap mb-1"></ol>
    <div class="qtype_speakup-image-message small mb-1 hide" role="status" aria-live="polite"></div>
    <input type="file" class="qtype_speakup-image-input sr-only visually-hidden" accept="{{accept}}"{{#multiple}} multiple{{/multiple}} tabindex="-1">
    <button type="button" class="qtype_speakup-image-button btn btn-secondary">
        {{#str}}uploadimage, qtype_speakup{{/str}}
    </button>
</div>
