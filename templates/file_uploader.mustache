{{!
    @template qtype_speakup/file_uploader

    File upload widget, shown instead of the recorder when the question's
    response method is "Upload". See amd/src/fileupload.js.

    Context variables required for this template:
    * hasfile: whether a file has already been uploaded.
    * fileurl: the URL of that file (empty string if none).
    * isvideo: whether that file is a video (otherwise it is audio).
    * accept: the file types the file picker offers.
    * candownload: whether the current user should see options to download the file.

    Example context (json):
    {
        "hasfile": false,
        "fileurl": "",
        "isvideo": false,
        "accept": ".mp3,.m4a,.wav,.mp4,.webm",
        "candownload": true
    }
}}
<div class="qtype_speakup-upload-widget my-1" data-state="{{#hasfile}}uploaded{{/hasfile}}{{^hasfile}}new{{/hasfile}}">
    <div class="qtype_speakup-no-recording-placeholder text-center w-100 mb-1{{#hasfile}} hide{{/hasfile}}">
        {{#str}}nofileuploaded, qtype_speakup{{/str}}
    </div>
    <div class="qtype_speakup-upload-player mb-1{{^hasfile}} hide{{/hasfile}}">
        <audio controls class="w-100{{#isvideo}} hide{{/isvideo}}"{{^candownload}} oncontextmenu="return false;" controlsList="nodownload"{{/candownload}}
            {{#hasfile}}{{^isvideo}} src="{{fileurl}}"{{/isvideo}}{{/hasfile}}></audio>
        <video controls playsinline class="w-100{{^isvideo}} hide{{/isvideo}}"{{^candownload}} oncontextmenu="return false;" controlsList="nodownload"{{/candownload}}
            {{#hasfile}}{{#isvideo}} src="{{fileurl}}"{{/isvideo}}{{/hasfile}}></video>
    </div>
    <div class="qtype_speakup-upload-message small mb-1 hide" role="status" aria-live="polite"></div>
    <input type="file" class="qtype_speakup-upload-input sr-only visually-hidden" accept="{{accept}}" tabindex="-1">
    <button type="button" class="qtype_speakup-upload-button btn btn-secondary w-100">
        {{#hasfile}}{{#str}}uploaddifferentfile, qtype_speakup{{/str}}{{/hasfile}}
        {{^hasfile}}{{#str}}uploadfile, qtype_speakup{{/str}}{{/hasfile}}
    </button>
</div>
