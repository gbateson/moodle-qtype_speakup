{{!
    @template qtype_speakup/audioprompt_editor

    The audio prompt widget on the question form: the audio recorder, plus
    buttons to upload an audio file or delete the prompt. See
    amd/src/audioprompt.js.

    Context variables required for this template:
    * id: the id of the outer element.
    * accept: the file types the file picker offers.
    * recorder: the context for qtype_speakup/audio_recorder.

    Example context (json):
    {
        "id": "qtype_speakup-audioprompt",
        "accept": "audio/*,.mp3,.m4a,.wav",
        "recorder": {
            "filename": "audioprompt.ogg",
            "widgetname": "Record the audio prompt",
            "maxrecordingduration": 300,
            "allowpausing": true,
            "hasrecording": false,
            "recordingurl": "",
            "candownload": true
        }
    }
}}
<div id="{{id}}" class="qtype_speakup-audioprompt-editor w-100">
    {{#recorder}}{{> qtype_speakup/audio_recorder }}{{/recorder}}
    <div class="mt-1">
        <input type="file" class="qtype_speakup-audioprompt-input sr-only visually-hidden" accept="{{accept}}" tabindex="-1">
        <button type="button" class="qtype_speakup-audioprompt-upload btn btn-secondary">{{#str}}uploadfile, qtype_speakup{{/str}}</button>
        <button type="button" class="qtype_speakup-audioprompt-delete btn btn-secondary hide">{{#str}}delete{{/str}}</button>
    </div>
    <div class="qtype_speakup-audioprompt-message small mt-1" role="status" aria-live="polite"></div>
</div>
